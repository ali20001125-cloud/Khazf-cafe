# Neon Postgres — من لوحة المشروع: Connection Details
# سرّ خادمي بحت. لا تضع عليه بادئة NEXT_PUBLIC_ أبداً.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/khazf_cafe?sslmode=require&channel_binding=require

# سرّ توقيع الجلسة — ولّد واحداً: node -e "console.log(require(\047crypto\047).randomBytes(32).toString(\047base64url\047))"
SESSION_SECRET=change-me-to-a-random-32-byte-string

# مزوّد إرسال رمز التحقّق على واتساب.
#
# **فارغٌ عمداً.** ما دام فارغاً، لا يطلب النظام رمزاً أصلاً: يسجّل
# الزبون برقمه واسمه في خطوةٍ واحدة. لأن النظام لا يسأل عن شيءٍ لا
# يستطيع إرساله — وكان يسأل، فينتظر الزبون رسالةً لن تصل.
#
# ويوم يُضبط هنا اسم المزوّد، تعود خطوة الرمز وحدها بلا تغيير كود.
# WHATSAPP_PROVIDER=

# تخزين صور المنيو — Neon Storage (من لوحة Neon: Storage ← Bucket ← Credentials).
#
# **اختياري.** ما دام فارغاً، لا تُعرض أزرار رفع الصور خطأً بل تُرفض
# محاولة الرفع برسالةٍ تقول إن التخزين غير مضبوط — والمنيو يعمل كما هو
# برسوم خزف مكان الصور.
#
# والمفتاح السرّي كلمة سرّ: يُوضع في متغيّرات الاستضافة ولا يُكتب في
# مستودع الكود.
# NEON_S3_ENDPOINT=https://<branch-id>.storage.c-6.eu-central-1.aws.neon.tech
# NEON_S3_BUCKET=khazf-menu
# NEON_S3_REGION=eu-central-1
# NEON_S3_KEY=nak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEON_S3_SECRET=nsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# نطاق الزبون — الفصل بين المنيو والإدارة بلا نشرتين.
#
# **اختياري.** فارغٌ يعني نطاقاً واحداً كما هو الآن.
#
# ويوم تربط نطاقاً ثانياً للمنيو، ضع اسمه هنا (بلا https وبلا / في
# آخره). عندها: ما جاء على هذا النطاق لا يرى صفحة دخولٍ ولا لوحة ولا
# كاشير — يُعرض له المنيو مكانها. والنطاق الآخر يبقى للعمل.
#
# والنطاقان يشيران إلى التطبيق نفسه: نشرةٌ واحدة، وقاعدةٌ واحدة،
# وإصلاحٌ واحد يصل الاثنين.
# PUBLIC_HOST=menu.khazaf.com

# موقع المنيو وحده — لموقعٍ ثانٍ على هوستنجر من الكود نفسه.
#
# ضعه **في موقع المنيو فقط**، لا في موقع الإدارة — وإلّا انقفلت عليك
# اللوحة والكاشير.
#
# عندها: كل صفحة عملٍ (الدخول، الإدارة، الكاشير) تُعرض منيو، على أيّ
# نطاقٍ فُتح الموقع. ولا يحتاج هذا الموقع متغيّرات NEON_S3_ — الصور
# تُرفع من الإدارة وحدها.
# MENU_ONLY=1

# الأجهزة الموثوقة — لموقع العمل وحده (pos)، لا لموقع المنيو.
#
# **اختياري.** فارغٌ يعني: من يعرف رابط موقع العمل يرى شاشة الدخول.
#
# وحين يُضبط: موقع العمل لا يُظهر شاشة دخولٍ ولا لوحةً ولا كاشيراً إلّا
# لجهازٍ سُجِّل مرّةً بفتح الرابط:
#     https://<موقع العمل>/device/<هذا المفتاح>
# وما سواه يرى 404 عارية في كل مسار. المفتاح كلمة سرّ: لا يُكتب في المستودع ولا يُصوَّر.
# ومن فقد جهازاً أو شكّ في الرابط: يغيّر المفتاح هنا ويعيد النشر،
# فتسقط الأجهزة كلّها ويُسجّلها من جديد.
# STAFF_DEVICE_KEY=
